#!/usr/bin/env bash

# ┌────────────────────────────────────────────┐
# │           Icon Theme Switcher              │
# └────────────────────────────────────────────┘

# Rofi theme switcher with keyboard navigation (k/j + up/down)
# Current theme shown with ★ and displayed at top

set -o errexit
set -o pipefail
set -o nounset

# Configuration
GTK3="$HOME/.config/gtk-3.0/settings.ini"
GTK4="$HOME/.config/gtk-4.0/settings.ini"
CACHE_DIR="$HOME/.cache/niri-themes"
CURRENT_ICON_FILE="$CACHE_DIR/current-icon-theme"
ICON_DIR="/usr/share/icons"

# ┌────────────────────────────────────────────┐
# │              Helper Functions              │
# └────────────────────────────────────────────┘
info() { echo -e "\033[1;36m[INFO]\033[0m $1"; }
ok() { echo -e "\033[1;32m[OK]\033[0m $1"; }
warn() { echo -e "\033[1;33m[WARN]\033[0m $1"; }
error() {
  echo -e "\033[1;31m[ERROR]\033[0m $1"
  exit 1
}

# ┌────────────────────────────────────────────┐
# │              Get Current Icon Theme        │
# └────────────────────────────────────────────┘
get_current_icon_theme() {
  local theme=""

  # Try to get from cache file first
  if [[ -f "$CURRENT_ICON_FILE" ]]; then
    theme="$(cat "$CURRENT_ICON_FILE" 2>/dev/null | xargs || true)"
  fi

  # If cache file is empty or doesn't exist, get from GTK settings
  if [[ -z "$theme" ]]; then
    theme="$(grep "gtk-icon-theme-name" "$GTK3" 2>/dev/null | cut -d= -f2 | xargs || true)"
  fi

  # If still empty, try GTK4
  if [[ -z "$theme" ]]; then
    theme="$(grep "gtk-icon-theme-name" "$GTK4" 2>/dev/null | cut -d= -f2 | xargs || true)"
  fi

  # Default fallback
  if [[ -z "$theme" ]]; then
    theme="Adwaita"
  fi

  echo "$theme"
}

# ┌────────────────────────────────────────────┐
# │              List Available Icon Themes    │
# └────────────────────────────────────────────┘
list_themes() {
  find "$ICON_DIR" \
    -mindepth 1 \
    -maxdepth 1 \
    -type d \
    -exec test -f "{}/index.theme" \; \
    -print 2>/dev/null | \
    xargs -n1 basename 2>/dev/null | \
    sort -u 2>/dev/null || true
}

# ┌────────────────────────────────────────────┐
# │              Update GTK Settings           │
# └────────────────────────────────────────────┘
update_gtk() {
  local file="$1"
  local theme="$2"

  mkdir -p "$(dirname "$file")" 2>/dev/null || true

  if [[ ! -f "$file" ]]; then
    cat >"$file" <<EOF 2>/dev/null || true
[Settings]
gtk-icon-theme-name=$theme
EOF
  else
    if grep -q "^gtk-icon-theme-name" "$file" 2>/dev/null; then
      sed -i "s/^gtk-icon-theme-name=.*/gtk-icon-theme-name=$theme/" "$file" 2>/dev/null || true
    else
      echo "gtk-icon-theme-name=$theme" >>"$file" 2>/dev/null || true
    fi
  fi
}

# ┌────────────────────────────────────────────┐
# │              Main Script                   │
# └────────────────────────────────────────────┘
main() {
  # Get current theme
  local current
  current="$(get_current_icon_theme)"

  # Get all themes
  local themes
  themes="$(list_themes)"

  # Build theme menu with current theme marked and at top
  local theme_menu=""

  # Add current theme first with ★ indicator
  if echo "$themes" | grep -q "^${current}$"; then
    theme_menu+="★ ${current}\n"
  else
    # If current theme not found in list, add it anyway
    theme_menu+="★ ${current}\n"
  fi

  # Add all other themes
  while IFS= read -r theme; do
    if [[ -n "$theme" && "$theme" != "$current" ]]; then
      theme_menu+="  ${theme}\n"
    fi
  done <<< "$themes"

  # Remove trailing newline
  theme_menu="${theme_menu%\\n}"

  # Show Rofi selector
  local chosen
  chosen="$(echo -e "$theme_menu" | \
    rofi \
      -dmenu \
      -i \
      -markup-rows \
      -p "󰉋 Icon Theme" \
      -show-icons \
      -theme-str '
window {
    width: 450px;
    padding: 20px;
    border-radius: 2px;
    border: 2px;
    border-color: #7aa2f7;
    background-color: rgba(26,27,38,0.92);
}

listview {
    lines: 10;
    fixed-height: true;
    scrollbar: false;
    spacing: 1px;
    background-color: rgba(26,27,38,0.92);
}

element {
    padding: 12px 16px;
    border-radius: 2px;
    background-color: rgba(26,27,38,0.92);
    text-color: #cdd6f4;
    font: "JetBrainsMono Bold 16";
}

element selected {
    background-color: rgba(122,162,247,0.30);
    text-color: #ffffff;
    border: 1px;
    border-color: #7aa2f7;
}

element icon {
    size: 1.2em;
    vertical-align: 0.2em;
}

prompt {
    text-color: #7dcfff;
    font: "JetBrainsMono Bold 16";
    padding: 0px 0px 12px 0px;
}

entry {
    text-color: #cdd6f4;
    background-color: rgba(26,27,38,0.95);
    placeholder-color: #6c7086;
    font: "JetBrainsMono Bold 13";
}
')"

  [[ -z "$chosen" ]] && exit 0

  # Clean selection (remove ★ and spaces)
  chosen="$(echo "$chosen" | sed 's/^[★ ]*//' | sed 's/^[ ]*//')"

  # Update GTK settings
  update_gtk "$GTK3" "$chosen"
  update_gtk "$GTK4" "$chosen"

  # Apply via gsettings
  if command -v gsettings >/dev/null 2>&1; then
    gsettings set org.gnome.desktop.interface icon-theme "$chosen" 2>/dev/null || true
  fi

  # Save current theme to cache
  mkdir -p "$CACHE_DIR" 2>/dev/null || true
  echo "$chosen" > "$CURRENT_ICON_FILE" 2>/dev/null || true

  # Notification
  if command -v notify-send >/dev/null 2>&1; then
    notify-send "Icon Theme Changed" "$chosen" 2>/dev/null || true
  fi

  echo "Changed icon theme: $chosen"
}

# Run main function
main "$@"
