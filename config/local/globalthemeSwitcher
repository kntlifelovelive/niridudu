#!/usr/bin/env bash

# ┌────────────────────────────────────────────┐
# │        Global Theme Switcher               │
# │        Author: NiriBuBu                    │
# │        Date: 2026                          │
# └────────────────────────────────────────────┘

# ┌────────────────────────────────────────────┐
# │              Configuration                 │
# └────────────────────────────────────────────┘

# Current user's home directory.
# Never hard-code username.
HOME_DIR="${HOME:?HOME is not set}"

# Script location.
# Only used to know where the executable is.
# Theme path does NOT depend on SCRIPT_DIR.
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

# User configuration directory.
CONFIG_DIR="$HOME_DIR/.config"

# Themes are stored here.
THEMES_DIR="$CONFIG_DIR/themes"

# Theme state.
STATE_DIR="$HOME_DIR/.cache/niri-themes"
CURRENT_THEME_FILE="$STATE_DIR/current-theme"

# ┌────────────────────────────────────────────┐
# │              Helper Functions              │
# └────────────────────────────────────────────┘

info() {
  printf '\033[1;36m[INFO]\033[0m %s\n' "$1"
}

ok() {
  printf '\033[1;32m[OK]\033[0m %s\n' "$1"
}

warn() {
  printf '\033[1;33m[WARN]\033[0m %s\n' "$1"
}

error() {
  printf '\033[1;31m[ERROR]\033[0m %s\n' "$1"
  return 1
}

# ┌────────────────────────────────────────────┐
# │              Validate Paths                │
# └────────────────────────────────────────────┘

validate_paths() {

  if [[ ! -d "$THEMES_DIR" ]]; then
    error "Themes directory not found: $THEMES_DIR"
    return 1
  fi

  return 0
}

# ┌────────────────────────────────────────────┐
# │              List Available Themes         │
# └────────────────────────────────────────────┘

list_themes() {

  if [[ ! -d "$THEMES_DIR" ]]; then
    error "Themes directory not found: $THEMES_DIR"
    return 1
  fi

  find "$THEMES_DIR" \
    -mindepth 1 \
    -maxdepth 1 \
    -type d \
    -printf '%f\n' |
    sort

}

# ┌────────────────────────────────────────────┐
# │              Get Current Theme             │
# └────────────────────────────────────────────┘

get_current_theme() {

  if [[ -f "$CURRENT_THEME_FILE" ]]; then
    local current

    current="$(<"$CURRENT_THEME_FILE")"

    if [[ -n "$current" ]]; then
      printf '%s\n' "$current"
    else
      printf 'none\n'
    fi

  else
    printf 'none\n'
  fi

}

# ┌────────────────────────────────────────────┐
# │              Apply GTK Theme               │
# └────────────────────────────────────────────┘

apply_gtk() {

  local theme_dir="$1"
  local gtk_ini="$theme_dir/gtk.ini"

  if [[ ! -f "$gtk_ini" ]]; then
    warn "No gtk.ini found for theme, skipping GTK"
    return 0
  fi

  # GTK 3
  mkdir -p "$CONFIG_DIR/gtk-3.0" 2>/dev/null || true

  cp "$gtk_ini" \
    "$CONFIG_DIR/gtk-3.0/settings.ini" \
    2>/dev/null || true

  # GTK 4
  mkdir -p "$CONFIG_DIR/gtk-4.0" 2>/dev/null || true

  cp "$gtk_ini" \
    "$CONFIG_DIR/gtk-4.0/settings.ini" \
    2>/dev/null || true

  # GTK 2
  local gtk2_file="$HOME_DIR/.gtkrc-2.0"

  local gtk_theme
  local gtk_icon
  local gtk_cursor

  gtk_theme="$(
    grep 'gtk-theme-name' "$gtk_ini" |
      cut -d'=' -f2 |
      xargs 2>/dev/null || true
  )"

  gtk_icon="$(
    grep 'gtk-icon-theme-name' "$gtk_ini" |
      cut -d'=' -f2 |
      xargs 2>/dev/null || true
  )"

  gtk_cursor="$(
    grep 'gtk-cursor-theme-name' "$gtk_ini" |
      cut -d'=' -f2 |
      xargs 2>/dev/null || true
  )"

  {
    echo "include \"/usr/share/themes/$gtk_theme/gtk-2.0/gtkrc\""
    echo "gtk-icon-theme-name = \"$gtk_icon\""
    echo "gtk-cursor-theme-name = \"$gtk_cursor\""
  } >"$gtk2_file" 2>/dev/null || true

  ok "GTK theme applied"

}

# ┌────────────────────────────────────────────┐
# │              Apply Cursor Theme            │
# └────────────────────────────────────────────┘

apply_cursor() {

  local theme_dir="$1"
  local gtk_ini="$theme_dir/gtk.ini"

  if [[ ! -f "$gtk_ini" ]]; then
    warn "No gtk.ini found for cursor theme, skipping"
    return 0
  fi

  local cursor_theme

  cursor_theme="$(
    grep 'gtk-cursor-theme-name' "$gtk_ini" |
      cut -d'=' -f2 |
      xargs 2>/dev/null || true
  )"

  if [[ -z "$cursor_theme" ]]; then
    warn "No cursor theme found in gtk.ini, skipping"
    return 0
  fi

  # X11 cursor
  mkdir -p "$HOME_DIR/.icons/default" 2>/dev/null || true

  cat >"$HOME_DIR/.icons/default/index.theme" <<EOF
[Icon Theme]
Inherits=$cursor_theme
EOF

  # Wayland cursor
  mkdir -p "$CONFIG_DIR/environment.d" 2>/dev/null || true

  cat >"$CONFIG_DIR/environment.d/10-cursor.conf" <<EOF
XCURSOR_THEME=$cursor_theme
XCURSOR_SIZE=24
EOF

  ok "Cursor theme applied: $cursor_theme"

}

# ┌────────────────────────────────────────────┐
# │              Apply File Manager Theme      │
# └────────────────────────────────────────────┘

apply_file_manager() {

  local theme_dir="$1"
  local gtk_ini="$theme_dir/gtk.ini"

  if [[ ! -f "$gtk_ini" ]]; then
    warn "No gtk.ini found for file manager, skipping"
    return 0
  fi

  local gtk_theme

  gtk_theme="$(
    grep 'gtk-theme-name' "$gtk_ini" |
      cut -d'=' -f2 |
      xargs 2>/dev/null || true
  )"

  if [[ -z "$gtk_theme" ]]; then
    warn "No gtk theme found in gtk.ini, skipping"
    return 0
  fi

  if command -v gsettings &>/dev/null; then

    gsettings set \
      org.gnome.desktop.interface \
      gtk-theme \
      "$gtk_theme" \
      2>/dev/null || true

    gsettings set \
      org.gnome.desktop.interface \
      color-scheme \
      'prefer-dark' \
      2>/dev/null || true

  fi

  # Nemo
  if command -v gsettings &>/dev/null; then

    gsettings set \
      org.nemo.desktop \
      show-desktop-icons \
      false \
      2>/dev/null || true

  fi

  ok "File manager theme applied"

}

# ┌────────────────────────────────────────────┐
# │              Apply Wallpaper Color         │
# └────────────────────────────────────────────┘

apply_wallpaper_color() {

  local theme_dir="$1"
  local theme_json="$theme_dir/_theme.json"

  if [[ ! -f "$theme_json" ]]; then
    warn "No _theme.json found, skipping wallpaper color"
    return 0
  fi

  local color

  color="$(
    grep '"wallpaper-color"' "$theme_json" |
      sed 's/.*: "\(.*\)".*/\1/' \
        2>/dev/null || true
  )"

  if [[ -n "$color" ]]; then

    mkdir -p "$STATE_DIR" 2>/dev/null || true

    printf '%s\n' "$color" \
      >"$STATE_DIR/wallpaper-color" \
      2>/dev/null || true

    ok "Wallpaper color set: $color"

  else

    warn "No wallpaper-color found in _theme.json"

  fi

}

# ┌────────────────────────────────────────────┐
# │              Apply Theme                   │
# └────────────────────────────────────────────┘

apply_theme() {

  local theme_name="$1"

  # Remove accidental leading/trailing whitespace.
  theme_name="${theme_name#"${theme_name%%[![:space:]]*}"}"
  theme_name="${theme_name%"${theme_name##*[![:space:]]}"}"

  if [[ -z "$theme_name" ]]; then
    error "Empty theme name"
    return 1
  fi

  local theme_dir="$THEMES_DIR/$theme_name"

  # Important:
  # Validate the exact directory selected by the user.
  if [[ ! -d "$theme_dir" ]]; then

    error "Theme not found: $theme_dir"

    printf '\n'
    printf 'Available themes:\n'
    list_themes

    return 1
  fi

  info "Applying theme: $theme_name"

  # Apply components.
  apply_gtk "$theme_dir" ||
    warn "GTK theme application failed"

  apply_cursor "$theme_dir" ||
    warn "Cursor theme application failed"

  apply_file_manager "$theme_dir" ||
    warn "File manager theme application failed"

  apply_wallpaper_color "$theme_dir" ||
    warn "Wallpaper color application failed"

  # Save current theme.
  mkdir -p "$STATE_DIR" 2>/dev/null || true

  printf '%s\n' "$theme_name" \
    >"$CURRENT_THEME_FILE" \
    2>/dev/null || true

  # Reload Niri.
  if command -v niri &>/dev/null; then
    niri msg action reload-config 2>/dev/null || true
  fi

  # Restart Waybar.
  if pgrep -x waybar &>/dev/null; then

    pkill waybar 2>/dev/null || true

    sleep 0.5

    waybar &>/dev/null &

  fi

  ok "Theme '$theme_name' applied successfully!"

  return 0

}

# ┌────────────────────────────────────────────┐
# │              Rofi Theme Selector           │
# └────────────────────────────────────────────┘

rofi_selector() {

  if ! command -v rofi &>/dev/null; then
    error "rofi is not installed"
    return 1
  fi

  local themes
  themes="$(list_themes)" || return 1

  local current_theme
  current_theme="$(get_current_theme)"

  # ──────────────────────────────────────────
  # Build menu
  # ──────────────────────────────────────────

  local theme_menu=""

  # Only show current theme if it actually exists.
  if [[ "$current_theme" != "none" ]] &&
    [[ -d "$THEMES_DIR/$current_theme" ]]; then

    theme_menu+="★ ${current_theme}"$'\n'

  fi

  # Add themes.
  while IFS= read -r theme; do

    [[ -z "$theme" ]] && continue

    if [[ "$theme" != "$current_theme" ]]; then
      theme_menu+="  ${theme}"$'\n'
    fi

  done <<<"$themes"

  # Remove final newline safely.
  theme_menu="${theme_menu%$'\n'}"

  local chosen

  chosen="$(
    printf '%s\n' "$theme_menu" |
      rofi \
        -dmenu \
        -i \
        -markup-rows \
        -p "Global Theme Selector" \
        -theme-str '
window {
    width: 550px;
    padding: 20px;
    border-radius: 0px;
    border: 1px;
    border-color: #7aa2f7;
    background-color: rgba(26,27,38,0.92);
}

listview {
    lines: 10;
    fixed-height: true;
    scrollbar: true;
    spacing: 1px;
    background-color: rgba(26,27,38,0.92);
}

element {
    padding: 12px 16px;
    border-radius: 1px;
    background-color: rgba(26,27,38,0.92);
    text-color: #cdd6f4;
    font: "JetBrainsMono Bold 15";
}

element selected {
    background-color: rgba(122,162,247,0.30);
    text-color: #ffffff;
    border: 1px;
    border-color: #7aa2f7;
}

prompt {
    text-color: #7dcfff;
    font: "JetBrainsMono Bold 15";
    padding: 0px 0px 12px 0px;
}

entry {
    text-color: #cdd6f4;
    background-color: rgba(26,27,38,0.95);
    placeholder-color: #6c7086;
    font: "JetBrainsMono Bold 13";
}
'
  )"

  # Cancel.
  [[ -z "$chosen" ]] && return 0

  # Remove ★ and leading spaces.
  chosen="${chosen#★}"
  chosen="${chosen#"${chosen%%[![:space:]]*}"}"
  chosen="${chosen%"${chosen##*[![:space:]]}"}"

  # Final safety check.
  if [[ ! -d "$THEMES_DIR/$chosen" ]]; then

    error "Selected theme directory does not exist: $THEMES_DIR/$chosen"

    return 1
  fi

  apply_theme "$chosen"

}

# ┌────────────────────────────────────────────┐
# │              Main                          │
# └────────────────────────────────────────────┘

main() {

  case "${1:-}" in

  --list | -l)

    list_themes

    ;;

  --rofi | -r)

    rofi_selector

    ;;

  --current | -c)

    get_current_theme

    ;;

  --help | -h)

    echo "Usage: globalthemeSwitcher [OPTION] [THEME]"
    echo ""
    echo "Options:"
    echo "  -l, --list       List available themes"
    echo "  -r, --rofi       Open Rofi theme selector"
    echo "  -c, --current    Show current theme"
    echo "  -h, --help       Show this help"
    echo ""
    echo "Examples:"
    echo "  globalthemeSwitcher tokyonight"
    echo "  globalthemeSwitcher --rofi"
    echo "  globalthemeSwitcher --list"
    echo "  globalthemeSwitcher --current"

    ;;

  "")

    error "No theme specified. Use --help for usage."

    return 1
    ;;

  *)

    apply_theme "$1"

    ;;

  esac

}

# ┌────────────────────────────────────────────┐
# │              Startup                       │
# └────────────────────────────────────────────┘

validate_paths || exit 1

main "$@"
