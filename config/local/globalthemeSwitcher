#!/usr/bin/env bash

# ┌────────────────────────────────────────────┐
# │        Global Theme Switcher               │
# │        Author: NiriBuBu                    │
# │        Date: 2026                          │
# └────────────────────────────────────────────┘

# ┌────────────────────────────────────────────┐
# │              Configuration                 │
# └────────────────────────────────────────────┘
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(dirname "$SCRIPT_DIR")"
THEMES_DIR="$REPO_ROOT/themes"
CONFIG_DIR="$HOME/.config"
STATE_DIR="$HOME/.cache/niri-themes"
CURRENT_THEME_FILE="$STATE_DIR/current-theme"

# ┌────────────────────────────────────────────┐
# │              Helper Functions              │
# └────────────────────────────────────────────┘
info() { echo -e "\033[1;36m[INFO]\033[0m $1"; }
ok() { echo -e "\033[1;32m[OK]\033[0m $1"; }
warn() { echo -e "\033[1;33m[WARN]\033[0m $1"; }
error() {
  echo -e "\033[1;31m[ERROR]\033[0m $1"
  exit 1
}

# ┌────────────────────────────────────────────┐
# │              List Available Themes         │
# └────────────────────────────────────────────┘
list_themes() {
  find "$THEMES_DIR" -mindepth 1 -maxdepth 1 -type d -printf "%f\n" | sort 2>/dev/null || true
}

# ┌────────────────────────────────────────────┐
# │              Get Current Theme             │
# └────────────────────────────────────────────┘
get_current_theme() {
  if [[ -f "$CURRENT_THEME_FILE" ]]; then
    cat "$CURRENT_THEME_FILE" 2>/dev/null || echo "none"
  else
    echo "none"
  fi
}

# ┌────────────────────────────────────────────┐
# │              Apply GTK Theme               │
# └────────────────────────────────────────────┘
apply_gtk() {
  local theme_dir="$1"
  local gtk_ini="$theme_dir/gtk.ini"

  if [[ ! -f "$gtk_ini" ]]; then
    warn "No gtk.ini found for theme, skipping GTK"
    return 0
  fi

  # Apply to GTK 3 settings
  mkdir -p "$CONFIG_DIR/gtk-3.0" 2>/dev/null || true
  cp "$gtk_ini" "$CONFIG_DIR/gtk-3.0/settings.ini" 2>/dev/null || true

  # Apply to GTK 4 settings
  mkdir -p "$CONFIG_DIR/gtk-4.0" 2>/dev/null || true
  cp "$gtk_ini" "$CONFIG_DIR/gtk-4.0/settings.ini" 2>/dev/null || true

  # Apply to GTK 2
  local gtk2_file="$HOME/.gtkrc-2.0"
  {
    echo "include \"/usr/share/themes/$(grep 'gtk-theme-name' "$gtk_ini" | cut -d'=' -f2 | xargs 2>/dev/null)/gtk-2.0/gtkrc\""
    echo "gtk-icon-theme-name = \"$(grep 'gtk-icon-theme-name' "$gtk_ini" | cut -d'=' -f2 | xargs 2>/dev/null)\""
    echo "gtk-cursor-theme-name = \"$(grep 'gtk-cursor-theme-name' "$gtk_ini" | cut -d'=' -f2 | xargs 2>/dev/null)\""
  } >"$gtk2_file" 2>/dev/null || true

  ok "GTK theme applied"
}

# ┌────────────────────────────────────────────┐
# │              Apply Cursor Theme            │
# └────────────────────────────────────────────┘
apply_cursor() {
  local theme_dir="$1"
  local gtk_ini="$theme_dir/gtk.ini"

  if [[ ! -f "$gtk_ini" ]]; then
    warn "No gtk.ini found for cursor theme, skipping"
    return 0
  fi

  local cursor_theme
  cursor_theme="$(grep 'gtk-cursor-theme-name' "$gtk_ini" | cut -d'=' -f2 | xargs 2>/dev/null || true)"

  if [[ -z "$cursor_theme" ]]; then
    warn "No cursor theme found in gtk.ini, skipping"
    return 0
  fi

  # Apply to X11 cursor
  mkdir -p "$HOME/.icons/default" 2>/dev/null || true
  cat >"$HOME/.icons/default/index.theme" <<EOF 2>/dev/null || true
[Icon Theme]
Inherits=$cursor_theme
EOF

  # Apply to Wayland cursor via environment
  mkdir -p "$CONFIG_DIR/environment.d" 2>/dev/null || true
  cat >"$CONFIG_DIR/environment.d/10-cursor.conf" <<EOF 2>/dev/null || true
XCURSOR_THEME=$cursor_theme
XCURSOR_SIZE=24
EOF

  ok "Cursor theme applied: $cursor_theme"
}

# ┌────────────────────────────────────────────┐
# │              Apply File Manager Theme      │
# └────────────────────────────────────────────┘
apply_file_manager() {
  local theme_dir="$1"
  local gtk_ini="$theme_dir/gtk.ini"

  if [[ ! -f "$gtk_ini" ]]; then
    warn "No gtk.ini found for file manager, skipping"
    return 0
  fi

  local gtk_theme
  gtk_theme="$(grep 'gtk-theme-name' "$gtk_ini" | cut -d'=' -f2 | xargs 2>/dev/null || true)"

  if [[ -z "$gtk_theme" ]]; then
    warn "No gtk theme found in gtk.ini, skipping"
    return 0
  fi

  # Nautilus uses GTK settings, but we can also set gsettings
  if command -v gsettings &>/dev/null; then
    gsettings set org.gnome.desktop.interface gtk-theme "$gtk_theme" 2>/dev/null || true
    gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark' 2>/dev/null || true
  fi

  # Nemo uses GTK settings too
  if command -v gsettings &>/dev/null; then
    gsettings set org.nemo.desktop show-desktop-icons false 2>/dev/null || true
  fi

  ok "File manager theme applied"
}

# ┌────────────────────────────────────────────┐
# │              Apply Wallpaper Color         │
# └────────────────────────────────────────────┘
apply_wallpaper_color() {
  local theme_dir="$1"
  local theme_json="$theme_dir/_theme.json"

  if [[ ! -f "$theme_json" ]]; then
    warn "No _theme.json found, skipping wallpaper color"
    return 0
  fi

  local color
  color="$(grep '"wallpaper-color"' "$theme_json" | sed 's/.*: "\(.*\)".*/\1/' 2>/dev/null || true)"

  if [[ -n "$color" ]]; then
    mkdir -p "$STATE_DIR" 2>/dev/null || true
    echo "$color" >"$STATE_DIR/wallpaper-color" 2>/dev/null || true
    ok "Wallpaper color set: $color"
  else
    warn "No wallpaper-color found in _theme.json"
  fi
}

# ┌────────────────────────────────────────────┐
# │              Apply Theme                   │
# └────────────────────────────────────────────┘
apply_theme() {
  local theme_name="$1"
  local theme_dir="$THEMES_DIR/$theme_name"

  if [[ ! -d "$theme_dir" ]]; then
    error "Theme not found: $theme_name"
    return 1
  fi

  info "Applying theme: $theme_name"

  # Apply all components (continue even if one fails)
  apply_gtk "$theme_dir" || warn "GTK theme application failed"
  apply_cursor "$theme_dir" || warn "Cursor theme application failed"
  apply_file_manager "$theme_dir" || warn "File manager theme application failed"
  apply_wallpaper_color "$theme_dir" || warn "Wallpaper color application failed"

  # Save current theme state
  mkdir -p "$STATE_DIR" 2>/dev/null || true
  echo "$theme_name" >"$CURRENT_THEME_FILE" 2>/dev/null || true

  # Reload applications (continue even if fails)
  if command -v niri &>/dev/null; then
    niri msg action reload-config 2>/dev/null || true
  fi

  # Restart waybar to pick up theme changes (if running)
  if pgrep -x waybar &>/dev/null; then
    pkill waybar 2>/dev/null || true
    sleep 0.5 2>/dev/null || true
    waybar &>/dev/null &
  fi

  ok "Theme '$theme_name' applied successfully!"
  return 0
}

# ┌────────────────────────────────────────────┐
# │              Rofi Theme Selector           │
# └────────────────────────────────────────────┘
rofi_selector() {
  if ! command -v rofi &>/dev/null; then
    error "rofi is not installed"
    return 1
  fi

  local themes
  themes="$(list_themes)"
  local current_theme
  current_theme="$(get_current_theme)"

  # Build theme menu with current theme marked and at top
  local theme_menu=""

  # Add current theme first with ★ indicator
  if echo "$themes" | grep -q "^${current_theme}$"; then
    theme_menu+="★ ${current_theme}\n"
  else
    # If current theme not found in list, add it anyway
    theme_menu+="★ ${current_theme}\n"
  fi

  # Add all other themes
  while IFS= read -r theme; do
    if [[ -n "$theme" && "$theme" != "$current_theme" ]]; then
      theme_menu+="  ${theme}\n"
    fi
  done <<<"$themes"

  # Remove trailing newline
  theme_menu="${theme_menu%\\n}"

  local chosen
  chosen="$(echo -e "$theme_menu" | rofi -dmenu -i -markup-rows -p "Global Theme Selector" \
    -theme-str '
window {
    width: 550px;
    padding: 20px;
    border-radius: 0px;
    border: 1px;
    border-color: #7aa2f7;
    background-color: rgba(26,27,38,0.92);
}

listview {
    lines: 10;
    fixed-height: true;
    scrollbar: true;
    spacing: 1px;
    background-color: rgba(26,27,38,0.92);
}

element {
    padding: 12px 16px;
    border-radius: 1px;
    background-color: rgba(26,27,38,0.92);
    text-color: #cdd6f4;
    font: "JetBrainsMono Bold 15";
}

element selected {
    background-color: rgba(122,162,247,0.30);
    text-color: #ffffff;
    border: 1px;
    border-color: #7aa2f7;
}

prompt {
    text-color: #7dcfff;
    font: "JetBrainsMono Bold 15";
    padding: 0px 0px 12px 0px;
}

entry {
    text-color: #cdd6f4;
    background-color: rgba(26,27,38,0.95);
    placeholder-color: #6c7086;
    font: "JetBrainsMono Bold 13";
}
')"

  [[ -z "$chosen" ]] && return 0

  # Clean selection (remove ★ and spaces)
  chosen="$(echo "$chosen" | sed 's/^[★ ]*//' | sed 's/^[ ]*//')"

  apply_theme "$chosen"
}

# ┌────────────────────────────────────────────┐
# │              Main                         │
# └────────────────────────────────────────────┘
main() {
  case "${1:-}" in
  --list | -l)
    list_themes
    ;;
  --rofi | -r)
    rofi_selector
    ;;
  --current | -c)
    get_current_theme
    ;;
  --help | -h)
    echo "Usage: theme-switch.sh [OPTION] [THEME]"
    echo ""
    echo "Options:"
    echo "  -l, --list       List available themes"
    echo "  -r, --rofi       Open Rofi theme selector"
    echo "  -c, --current    Show current theme"
    echo "  -h, --help       Show this help"
    echo ""
    echo "Examples:"
    echo "  theme-switch.sh tokyonight"
    echo "  theme-switch.sh --rofi"
    ;;
  "")
    error "No theme specified. Use --help for usage."
    ;;
  *)
    apply_theme "$1"
    ;;
  esac
}

main "$@"
